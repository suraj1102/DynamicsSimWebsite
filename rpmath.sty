\def\handvec{\@handvec{0}}%
\DeclareRobustCommand\@handvec[2]{%
  \mathord{%
    \vbox{%
      \ialign{%
\hfil##\hfil\cr
        \noalign{\vskip-1.25\p@}%
$\mathord{\mkern#1mu\scriptscriptstyle\rightharpoonup\mkern-#1mu}$\cr
