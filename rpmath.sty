      }%
    }%
  }%
}%
 % SDH - replacement for all the handvec varieties
\def\Vec{\protect\accentset\rightharpoonup} % protect hopefully won't hurt
\def\@rightharpoonup{{%
  \setbox\z@\hbox{\lower1.2\p@\hbox{$\scriptscriptstyle\rightharpoonup$}}%
  \dp\z@0\p@\box\z@%
}}
\def\Vec{\protect\accentset\@rightharpoonup} % protect hopefully won't hurt
\def\@mkern@#1#2#3{\mathord{\mkern#2mu#1{\mkern-#2mu#3\mkern#2mu}\mkern-#2mu}}%
