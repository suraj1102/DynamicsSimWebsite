 %%
 %WFA couldn't get \@handvec to work in section heads &c.,
 %WFA so made an alternative version --- may be flexible
 %WFA enough to replace the original
\DeclareRobustCommand\HANDVEC[2]{%
  \overset{{\mkern#1mu\scriptscriptstyle\rightharpoonup}\mkern-#1mu}%
  {\smash{#2}\vrule width0pt height 1.05ex}%
}
 %WFA and since the vertical is hardwired, another for lc
\DeclareRobustCommand\HANDvec[2]{%
  \overset{{\mkern#1mu\scriptscriptstyle\rightharpoonup}\mkern-#1mu}%
  {\smash{#2}\vrule width0pt height .6ex}%
